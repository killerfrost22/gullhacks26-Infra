# Copy to server/.env and fill in. Never commit .env.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Must support image input + Google Search grounding + structured output (Gemini 3+).
GEMINI_MODEL=gemini-3.8-flash
PORT=8787
# Nominatim usage policy asks for a contact email in the User-Agent.
NOMINATIM_CONTACT=
