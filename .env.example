# Keep credentials on the server. Never prefix API keys with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
PORT=8787
HOST=127.0.0.1
# Sent to Nominatim and Overpass. Set a real operator contact before deploying against the public services.
GEOCODER_USER_AGENT=FixPlease/2.0 (local development)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Optional stable CAPTCHA signing secret. Leave blank for a cryptographically random per-process secret.
# Proofs expire after five minutes and are single-use; restarts invalidate outstanding challenges.
# Run one API process, or use sticky routing: challenge/replay state is local to that process.
CAPTCHA_SECRET=
# Map facts for routing (roads, campus grounds, street lights, city/county). Public Overpass by default;
# point this at a self-hosted or alternative instance if the public one is overloaded. Results are cached for 15 minutes.
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Behind a reverse proxy or hosting platform, set the number of proxy hops (usually 1) so rate limits see real
# client addresses instead of the proxy's. "true" trusts every X-Forwarded-For hop and lets clients spoof addresses.
# Leave blank when the server is reached directly.
TRUST_PROXY=
# Research requests allowed per client address every 15 minutes. Raise it for demos where many people share one
# network (venue Wi-Fi shows up as a single address). Each request uses two Gemini calls.
RESEARCH_RATE_LIMIT=5
